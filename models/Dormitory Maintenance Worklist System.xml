<?xml version="1.0"?>
<testset xmlns="http://cpee.org/ns/properties/2.0">
  <executionhandler>ruby</executionhandler>
  <dataelements>
    <location/>
    <category/>
    <description/>
    <urgency/>
    <materials_needed>false</materials_needed>
    <materials_list/>
    <materials_issued>false</materials_issued>
    <repair_notes/>
    <satisfied>false</satisfied>
    <rating>0</rating>
    <feedback/>
    <room/>
    <admin_decision/>
    <admin_note/>
    <assessment_notes>None</assessment_notes>
  </dataelements>
  <documents/>
  <endpoints>
    <user>https-post://cpee.org/services/timeout-user.php</user>
    <auto>https-post://cpee.org/services/timeout-auto.php</auto>
    <subprocess>https-post://cpee.org/flow/start/url/</subprocess>
    <timeout>https-post://cpee.org/services/timeout.php</timeout>
    <send>https-post://cpee.org/ing/correlators/message/send/</send>
    <receive>https-get://cpee.org/ing/correlators/message/receive/</receive>
    <worklist>https-post://cpee.org/worklist/server/</worklist>
  </endpoints>
  <attributes>
    <info>Dormitory Maintenance Worklist System</info>
    <creator>Christine Ashcreek</creator>
    <author>Christine Ashcreek</author>
    <modeltype>CPEE</modeltype>
    <guarded>none</guarded>
    <guarded_id/>
    <model_uuid>a3021cba-68ff-4c4e-a947-97952b5b223e</model_uuid>
    <model_version/>
    <theme>extended</theme>
    <design_dir>Teaching.dir/Prak.dir/TUM-Prak-26-SS.dir/XuRenyi.dir</design_dir>
    <design_stage>development</design_stage>
    <organisation1>https://cpee.org/~demo/orgviz/organisation_informatik.xml</organisation1>
  </attributes>
  <description>
    <description xmlns="http://cpee.org/ns/description/1.0">
      <call id="a8" endpoint="worklist">
        <parameters>
          <label>Admin review &amp; dispatch</label>
          <color/>
          <arguments>
            <orgmodel>https://lehre.bpm.in.tum.de/~go34sat/prak26/org/organisation.xml</orgmodel>
            <form>https://lehre.bpm.in.tum.de/~go34sat/prak26/forms/admin_review.html</form>
            <role>Admin</role>
            <priority>1</priority>
            <handling>single</handling>
            <restrictions/>
            <data>
              <location>!data.location</location>
              <room>!data.room</room>
              <category>!data.category</category>
              <description>!data.description</description>
              <urgency>!data.urgency</urgency>
              <admin_decision>!data.admin_decision</admin_decision>
              <admin_note>!data.admin_note</admin_note>
            </data>
          </arguments>
        </parameters>
        <code>
          <signal>false</signal>
          <prepare/>
          <finalize output="result">form = result["raw"].to_h { |field| [field["name"], field["value"]] }
data.admin_decision = form["admin_decision"]
data.admin_note = form["admin_note"]</finalize>
          <update output="result"/>
          <rescue output="result"/>
        </code>
        <annotations>
          <_generic/>
          <_logging_behavior>
            <_exclude>false</_exclude>
            <_include>false</_include>
          </_logging_behavior>
          <_timing>
            <_timing_weight/>
            <_timing_avg/>
            <explanations/>
          </_timing>
          <_shifting>
            <_shifting_type>Duration</_shifting_type>
          </_shifting>
          <_context_data_analysis>
            <probes/>
            <ips/>
          </_context_data_analysis>
          <report>
            <url/>
          </report>
          <_notes>
            <_notes_general/>
          </_notes>
        </annotations>
        <documentation>
          <input/>
          <output/>
          <implementation>
            <description/>
          </implementation>
          <code>
            <description/>
          </code>
        </documentation>
      </call>
      <choose eid="e6" mode="exclusive" label="">
        <alternative eid="e7" condition="data.admin_decision == &quot;rejected&quot;">
          <terminate eid="e9" abandon="false"/>
          <_probability>
            <_probability_min/>
            <_probability_max/>
            <_probability_avg/>
          </_probability>
        </alternative>
        <otherwise eid="e8"/>
      </choose>
      <call id="a4" endpoint="worklist">
        <parameters>
          <label>Technician on-site assessment</label>
          <color/>
          <arguments>
            <orgmodel>https://lehre.bpm.in.tum.de/~go34sat/prak26/org/organisation.xml</orgmodel>
            <form>https://lehre.bpm.in.tum.de/~go34sat/prak26/forms/technician_assessment.html</form>
            <role>Technician</role>
            <priority>1</priority>
            <handling>single</handling>
            <restrictions/>
            <data>
              <location>!data.location</location>
              <description>!data.description</description>
              <materials_needed>!data.materials_needed</materials_needed>
              <materials_list>!data.materials_list</materials_list>
              <room>!data.room</room>
              <category>!data.category</category>
              <urgency>!data.urgency</urgency>
              <assessment_notes>!data.assessment_notes</assessment_notes>
            </data>
          </arguments>
        </parameters>
        <code>
          <signal>false</signal>
          <prepare/>
          <finalize output="result">form = result["raw"].to_h { |field| [field["name"], field["value"]] }
data.materials_needed = form["materials_needed"] == "true"
data.materials_list = form["materials_list"]
data.assessment_notes = form["assessment_notes"]
data.materials_issued = false</finalize>
          <update output="result"/>
          <rescue output="result"/>
        </code>
        <annotations>
          <_generic/>
          <_logging_behavior>
            <_exclude>false</_exclude>
            <_include>false</_include>
          </_logging_behavior>
          <_timing>
            <_timing_weight/>
            <_timing_avg/>
            <explanations/>
          </_timing>
          <_shifting>
            <_shifting_type>Duration</_shifting_type>
          </_shifting>
          <_context_data_analysis>
            <probes/>
            <ips/>
          </_context_data_analysis>
          <report>
            <url/>
          </report>
          <_notes>
            <_notes_general/>
          </_notes>
        </annotations>
        <documentation>
          <input/>
          <output/>
          <implementation>
            <description/>
          </implementation>
          <code>
            <description/>
          </code>
        </documentation>
      </call>
      <choose eid="e1" mode="exclusive" label="Materials needed?">
        <alternative eid="e2" condition="data.materials_needed == true">
          <call id="a5" endpoint="worklist">
            <parameters>
              <label>Inventory approval</label>
              <color/>
              <arguments>
                <orgmodel>https://lehre.bpm.in.tum.de/~go34sat/prak26/org/organisation.xml</orgmodel>
                <form>https://lehre.bpm.in.tum.de/~go34sat/prak26/forms/inventory_approval.html</form>
                <role>InventoryManager</role>
                <priority>1</priority>
                <handling>single</handling>
                <restrictions/>
                <data>
                  <materials_list>!data.materials_list</materials_list>
                  <materials_issued>!data.materials_issued</materials_issued>
                  <location>!data.location</location>
                  <room>!data.room</room>
                </data>
              </arguments>
            </parameters>
            <code>
              <signal>false</signal>
              <prepare/>
              <finalize output="result">form = result["raw"].to_h { |field| [field["name"], field["value"]] }
data.materials_issued = form["materials_issued"] == "true"</finalize>
              <update output="result"/>
              <rescue output="result"/>
            </code>
            <annotations>
              <_generic/>
              <_logging_behavior>
                <_exclude>false</_exclude>
                <_include>false</_include>
              </_logging_behavior>
              <_timing>
                <_timing_weight/>
                <_timing_avg/>
                <explanations/>
              </_timing>
              <_shifting>
                <_shifting_type>Duration</_shifting_type>
              </_shifting>
              <_context_data_analysis>
                <probes/>
                <ips/>
              </_context_data_analysis>
              <report>
                <url/>
              </report>
              <_notes>
                <_notes_general/>
              </_notes>
            </annotations>
            <documentation>
              <input/>
              <output/>
              <implementation>
                <description/>
              </implementation>
              <code>
                <description/>
              </code>
            </documentation>
          </call>
          <_probability>
            <_probability_min/>
            <_probability_max/>
            <_probability_avg/>
          </_probability>
        </alternative>
        <otherwise eid="e3"/>
      </choose>
      <loop eid="e4" mode="post_test" condition="data.satisfied == false">
        <call id="a1" endpoint="worklist">
          <parameters>
            <label>Carry out repair &amp; mark complete</label>
            <color/>
            <arguments>
              <orgmodel>https://lehre.bpm.in.tum.de/~go34sat/prak26/org/organisation.xml</orgmodel>
              <form>https://lehre.bpm.in.tum.de/~go34sat/prak26/forms/repair_complete.html</form>
              <role>Technician</role>
              <priority>1</priority>
              <handling>single</handling>
              <restrictions/>
              <data>
                <repair_notes>!data.repair_notes</repair_notes>
                <location>!data.location</location>
                <room>!data.room</room>
                <assessment_notes>!data.assessment_notes</assessment_notes>
                <materials_list>!data.materials_list</materials_list>
                <category>!data.category</category>
              </data>
            </arguments>
          </parameters>
          <code>
            <signal>false</signal>
            <prepare/>
            <finalize output="result">form = result["raw"].to_h { |field| [field["name"], field["value"]] }
data.repair_notes = form["repair_notes"]</finalize>
            <update output="result"/>
            <rescue output="result"/>
          </code>
          <annotations>
            <_generic/>
            <_logging_behavior>
              <_exclude>false</_exclude>
              <_include>false</_include>
            </_logging_behavior>
            <_timing>
              <_timing_weight/>
              <_timing_avg/>
              <explanations/>
            </_timing>
            <_shifting>
              <_shifting_type>Duration</_shifting_type>
            </_shifting>
            <_context_data_analysis>
              <probes/>
              <ips/>
            </_context_data_analysis>
            <report>
              <url/>
            </report>
            <_notes>
              <_notes_general/>
            </_notes>
          </annotations>
          <documentation>
            <input/>
            <output/>
            <implementation>
              <description/>
            </implementation>
            <code>
              <description/>
            </code>
          </documentation>
        </call>
        <_probability>
          <_probability_min/>
          <_probability_max/>
          <_probability_avg/>
        </_probability>
        <_annotations>
          <_generic/>
          <_logging_behavior>
            <_iteration>false</_iteration>
          </_logging_behavior>
        </_annotations>
        <call id="a6" endpoint="worklist">
          <parameters>
            <label>Student confirmation &amp; rating</label>
            <color/>
            <arguments>
              <orgmodel>https://lehre.bpm.in.tum.de/~go34sat/prak26/org/organisation.xml</orgmodel>
              <form>https://lehre.bpm.in.tum.de/~go34sat/prak26/forms/student_confirmation.html</form>
              <role>Student</role>
              <priority>1</priority>
              <handling>single</handling>
              <restrictions/>
              <data>
                <satisfied>!data.satisfied</satisfied>
                <rating>!data.rating</rating>
                <feedback>!data.feedback</feedback>
                <location>!data.location</location>
                <room>!data.room</room>
                <category>!data.category</category>
                <repair_notes>!data.repair_notes</repair_notes>
              </data>
            </arguments>
          </parameters>
          <code>
            <signal>false</signal>
            <prepare/>
            <finalize output="result">form = result["raw"].to_h { |field| [field["name"], field["value"]] }
data.satisfied = form["satisfied"] == "true"
data.rating = form["rating"].to_i
data.feedback = form["feedback"]</finalize>
            <update output="result"/>
            <rescue output="result"/>
          </code>
          <annotations>
            <_generic/>
            <_logging_behavior>
              <_exclude>false</_exclude>
              <_include>false</_include>
            </_logging_behavior>
            <_timing>
              <_timing_weight/>
              <_timing_avg/>
              <explanations/>
            </_timing>
            <_shifting>
              <_shifting_type>Duration</_shifting_type>
            </_shifting>
            <_context_data_analysis>
              <probes/>
              <ips/>
            </_context_data_analysis>
            <report>
              <url/>
            </report>
            <_notes>
              <_notes_general/>
            </_notes>
          </annotations>
          <documentation>
            <input/>
            <output/>
            <implementation>
              <description/>
            </implementation>
            <code>
              <description/>
            </code>
          </documentation>
        </call>
      </loop>
    </description>
  </description>
  <transformation>
    <description type="copy"/>
    <dataelements type="none"/>
    <endpoints type="none"/>
  </transformation>
</testset>
